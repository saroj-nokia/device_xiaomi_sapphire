android_app {
    name: "DeviceParts",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    sdk_version: "current",
    certificate: "platform",
    privileged: true,
    product_specific: true,
    optimize: {
        enabled: false,
    },
}
