type vendor_zram_init_shell, domain;
type vendor_zram_init_shell_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_zram_init_shell)

allow vendor_zram_init_shell vendor_shell_exec:file rx_file_perms;
allow vendor_zram_init_shell vendor_toolbox_exec:file rx_file_perms;

# Allow ZRAM operations
allow vendor_zram_init_shell sysfs_zram:dir r_dir_perms;
allow vendor_zram_init_shell sysfs_zram:file rw_file_perms;
allow vendor_zram_init_shell block_device:dir search;
allow vendor_zram_init_shell swap_block_device:blk_file rw_file_perms;

allow vendor_zram_init_shell self:capability sys_admin;

# Property access
set_prop(vendor_zram_init_shell, vendor_zram_prop)
get_prop(vendor_zram_init_shell, vendor_zram_prop)
