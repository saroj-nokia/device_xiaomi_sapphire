# Remove the wrong early-boot section
# on early-boot
#     chmod 0664 /sys/bus/platform/devices/soc:xiaomi_fingerprint/fingerdown
#     chown system graphics /sys/bus/platform/devices/soc:xiaomi_fingerprint/fingerdown

on post-fs-data
    mkdir /data/vendor/misc 01771 system system
    mkdir /data/vendor/misc/xiaomi-fp 0770 system system
    mkdir /persist/xioami-fp 0770 system system
    mkdir /mnt/vendor/persist/mi_fp 0770 system system
    mkdir /data/vendor/fpc 0770 system system
    mkdir /data/vendor/fpdump 0770 system system
    mkdir /data/vendor/goodix 0770 system system
    mkdir /data/vendor/fingerprint 0770 system system
    mkdir /mnt/vendor/persist/goodix 0770 system system
    mkdir /mnt/vendor/persist/fpc 0770 system system

# For the NFC variant (sapphiren)
on post-fs && property:ro.boot.hwname=sapphiren
    start stflashtool
    setprop ro.vendor.se.type HCE,UICC
    setprop ro.nfc.port I2C

on post-fs-data && property:ro.boot.hwname=sapphiren
    mkdir /data/vendor/nfc 0770 nfc nfc

# For the non-NFC variant (sapphire)
on boot && property:ro.boot.hwname=sapphire
    stop vendor.st_nfc_hal_service
    setprop ro.vendor.se.type ""

on boot
    # Deep sleep / Sleep states
    write /sys/power/mem_sleep "s2idle"
    write /sys/devices/system/cpu/qcom_lpm/parameters/sleep_disabled N

    # Goodix sensor (if you have dual sensor support)
    chmod 0666 /dev/goodix_fp
    chown system system /dev/goodix_fp
    
    # Xiaomi fingerprint device
    chmod 0666 /dev/xiaomi-fp
    chown system system /dev/xiaomi-fp
    
    # FOD press detection - CRITICAL for screen-off UDFPS
    chmod 0664 /sys/class/touch/touch_dev/fod_press_status
    chown system graphics /sys/class/touch/touch_dev/fod_press_status
    
    # Wakeup source
    chown system system /sys/devices/platform/soc/soc:fingerprint_xiaomi/wakeup/wakeup7/active
    chmod 0660 /sys/devices/platform/soc/soc:fingerprint_xiaomi/wakeup/wakeup7/active
    
    # Touch test
    chmod 0664 /sys/class/touch/touch_dev/touch_dfs_test
    chown system system /sys/class/touch/touch_dev/touch_dfs_test

    chmod 0666 /dev/input/event2

on property:sys.boot_completed=1
    chmod 440 /proc/net/unix

service vendor.st_nfc_hal_service /vendor/bin/hw/android.hardware.nfc@1.2-service.st
    override
    class hal
    user nfc
    group nfc
    disabled

service stflashtool /vendor/bin/STFlashTool
    override
    class late_start
    group nfc
    user nfc
    oneshot
    disabled

service vendor.goodix-events /vendor/bin/init.goodix.events.sh
    class late_start
    user root
    group root system input
    disabled
    oneshot      

on property:sys.boot_completed=1
    start vendor.goodix-events

on property:ro.boot.hwname=*
    setprop ro.boot.product.hardware.sku ${ro.boot.hwname}

# Controle de ZRAM via DeviceParts (Gatilhos completos)
on property:persist.vendor.zram_size=0
    exec_background u:r:vendor_qti_init_shell:s0 root root -- /vendor/bin/init.zram.sh 0

on property:persist.vendor.zram_size=1024
    exec_background u:r:vendor_qti_init_shell:s0 root root -- /vendor/bin/init.zram.sh 1024

on property:persist.vendor.zram_size=2048
    exec_background u:r:vendor_qti_init_shell:s0 root root -- /vendor/bin/init.zram.sh 2048

on property:persist.vendor.zram_size=3072
    exec_background u:r:vendor_qti_init_shell:s0 root root -- /vendor/bin/init.zram.sh 3072

on property:persist.vendor.zram_size=4096
    exec_background u:r:vendor_qti_init_shell:s0 root root -- /vendor/bin/init.zram.sh 4096

on property:persist.vendor.zram_size=6144
    exec_background u:r:vendor_qti_init_shell:s0 root root -- /vendor/bin/init.zram.sh 6144

on property:persist.vendor.zram_size=8192
    exec_background u:r:vendor_qti_init_shell:s0 root root -- /vendor/bin/init.zram.sh 8192

on property:persist.vendor.zram_size=12288
    exec_background u:r:vendor_qti_init_shell:s0 root root -- /vendor/bin/init.zram.sh 12288

on property:persist.vendor.zram_size=16384
    exec_background u:r:vendor_qti_init_shell:s0 root root -- /vendor/bin/init.zram.sh 16384
